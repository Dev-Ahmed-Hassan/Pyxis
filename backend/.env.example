DATABASE_URL=postgresql://user:password@host:port/database
MONGODB_URL=mongodb+srv://user:password@host/database
MONGODB_DATABASE=career_assistant
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM task routing uses provider:model entries. Keep fallback entries comma-separated.
LLM_RESUME_PARSER_PRIMARY=gemini:gemini-2.5-flash
LLM_RESUME_PARSER_FALLBACKS=groq:openai/gpt-oss-20b
LLM_INTERNSHIP_PARSER_PRIMARY=gemini:gemini-2.5-flash
LLM_INTERNSHIP_PARSER_FALLBACKS=groq:openai/gpt-oss-20b
LLM_MATCH_ADJUDICATOR_PRIMARY=gemini:gemini-2.5-flash
LLM_MATCH_ADJUDICATOR_FALLBACKS=groq:openai/gpt-oss-20b
LLM_MATCH_EXPLAINER_PRIMARY=gemini:gemini-2.5-flash
LLM_MATCH_EXPLAINER_FALLBACKS=groq:openai/gpt-oss-20b
LLM_CAREER_RECOMMENDER_PRIMARY=gemini:gemini-2.5-flash
LLM_CAREER_RECOMMENDER_FALLBACKS=groq:openai/gpt-oss-20b
LLM_GITHUB_ANALYZER_PRIMARY=gemini:gemini-2.5-flash
LLM_GITHUB_ANALYZER_FALLBACKS=groq:openai/gpt-oss-20b
LLM_PROMPT_GUARD_PRIMARY=groq:meta-llama/llama-prompt-guard-2-86m
EMBEDDING_MODEL_ROUTE=gemini:gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Add standby keys only for credential rotation and legitimate failover.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# Optional. Raises GitHub API rate limits for public profile snapshot fetches.
GITHUB_API_TOKEN=
